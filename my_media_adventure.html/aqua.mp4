LOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982975,"raisedBackground":4293982975,"additiveBackground":556638689,"textPrimary":4278396989,"textSecondary":4279396246,"invertedBackground":4279396246,"overlayBackground":3422758973},"darkThemeColorPalette":{"baseBackground":4278260510,"raisedBackground":4278396989,"additiveBackground":724410849,"textPrimary":4292735741,"textSecondary":4287943412,"invertedBackground":4285711085,"overlayBackground":3422758973},"colorSampledDescriptionBodyText":{"content":"The Ocean is one of the most beautiful and mesmerizing place on earth. Enjoy this 4k Scenic Wildlife film featuring the animals that call the Ocean home. From Humpback whales singing in the deep, to dolphins playing in the waves, our oceans are full of the most amazing animals! What is your favorite marine animal?\n\nOur other wildlife films:\n\nEarth's Animals 4K -    • Earth's Animals - Scenic Wildlife Film wit...  \n\nUnder the Sea 4K -    • Under The Sea 4K - Scenic Wildlife Film Wi...  \n\nAfrica's Animals 4K -    • Africa's Animals 4K - Scenic Wildlife Film...  \n\nThe Ocean 4K -    • The Ocean 4K - Scenic Wildlife Film With C...  \n\nAnimals of Asia 4K -    • Wildlife of Asia 4K - Scenic Animal Film W...  \n\nBig Cats 4K -    • Big Cats Of The World 4K - Scenic Wildlife...  \n\nMonkeys 4K -    • Monkeys \u0026 Primates 4K - Scenic Wildlife Fi...  \n\nAustralia's Animals 4K -    • Animals of Australia 4K - Scenic Wildlife ...  \n\nThe Amazon 4K -    • The Amazon 4K - Scenic Wildlife Film With ...  \n\nBirds of the World 4K -    • Birds Of The World 4K - Scenic Wildlife Fi...  \n\nFollow us on instagram @scenicrelaxationfilms\n\nWhere we get our music - https://fm.pxf.io/scenicfreetrial\nGreat Place for Stock footage - https://bit.ly/3GptQHd\nGreat Place for Assets - https://bit.ly/3K59ZPK\n\nTimestamps:\n\n0:00 - Animals of the Ocean\n11:05 - Whales\n13:57 - Sharks\n17:16 - Dolphins\n20:44 - Seals \u0026 Sea Lions\n23:37 - Sea Turtles\n25:57 - Schools of Fish\n30:26 - Coral Reefs\n34:02 - Dugongs \u0026 Manatees\n36:05 - Rays \u0026 Mobulas\n39:30 - Peculiar Creatures of the Sea\n42:29 - Ocean World\n57:39 - Outro\n\nThanks for watching :)","commandRuns":[{"startIndex":365,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBkQ040EGAciEwignamc-vyUAxXP31UJHeQnDDXKAQTtDPkP","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=55xU9focn9M","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"55xU9focn9M","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr6---sn-gwpa-itqer.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026siu=1\u0026msp=1\u0026odepv=1\u0026id=e79c54f5fa1c9fd3\u0026ip=2409%3A408c%3A1d18%3Abf15%3Af401%3Ae0a1%3A8f6%3A33d7\u0026initcwndbps=873750\u0026mt=1781103196\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"YouTube Channel Link: Earth's Animals - Scenic Wildlife Film with Inspiring Music"}}},{"startIndex":438,"length":52,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBkQ040EGAciEwignamc-vyUAxXP31UJHeQnDDXKAQTtDPkP","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=mh6WChUVxOQ","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"mh6WChUVxOQ","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr2---sn-gwpa-itql7.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026ofpcc=1\u0026siu=1\u0026msp=1\u0026odepv=1\u0026id=9a1e960a1515c4e4\u0026ip=2409%3A408c%3A1d18%3Abf15%3Af401%3Ae0a1%3A8f6%3A33d7\u0026initcwndbps=883750\u0026mt=1781103196\u0026oweuc="}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLa